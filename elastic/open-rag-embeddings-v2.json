{
  "index_name": "open-rag-embeddings-v2",
  "pipeline_name": "open_rag_embeddings_v2_semantic_pipeline",
  "index": {
    "settings": {
      "index.default_pipeline": "open_rag_embeddings_v2_semantic_pipeline"
    },
    "mappings": {
      "dynamic": false,
      "_meta": {
        "description": "Semantic text mapping for one normalized RAG chunk per indexed document.",
        "inference_id": "qwen3-embedding-8b",
        "expected_model_settings": {
          "service": "custom",
          "task_type": "text_embedding",
          "dimensions": 4096,
          "similarity": "dot_product",
          "element_type": "float"
        },
        "chunking": "Automatic semantic_text chunking is disabled because the service already indexes pre-chunked records."
      },
      "properties": {
        "content": {
          "type": "text"
        },
        "content_semantic": {
          "type": "semantic_text",
          "inference_id": "qwen3-embedding-8b",
          "model_settings": {
            "service": "custom",
            "task_type": "text_embedding",
            "dimensions": 4096,
            "similarity": "dot_product",
            "element_type": "float"
          },
          "index_options": {
            "dense_vector": {
              "element_type": "float",
              "type": "int8_hnsw"
            }
          },
          "chunking_settings": {
            "strategy": "none"
          }
        },
        "title": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "title_semantic": {
          "type": "semantic_text",
          "inference_id": "qwen3-embedding-8b",
          "model_settings": {
            "service": "custom",
            "task_type": "text_embedding",
            "dimensions": 4096,
            "similarity": "dot_product",
            "element_type": "float"
          },
          "index_options": {
            "dense_vector": {
              "element_type": "float",
              "type": "int8_hnsw"
            }
          },
          "chunking_settings": {
            "strategy": "none"
          }
        },
        "record_id": {
          "type": "keyword"
        },
        "document_id": {
          "type": "keyword"
        },
        "job_id": {
          "type": "keyword"
        },
        "chunk_id": {
          "type": "keyword"
        },
        "record_type": {
          "type": "keyword"
        },
        "source_file_name": {
          "type": "keyword",
          "fields": {
            "text": {
              "type": "text"
            }
          }
        },
        "input_format": {
          "type": "keyword"
        },
        "parser": {
          "type": "keyword"
        },
        "pipeline": {
          "type": "keyword"
        },
        "chunker_strategy": {
          "type": "keyword"
        },
        "page_start": {
          "type": "integer"
        },
        "page_end": {
          "type": "integer"
        },
        "element_types": {
          "type": "keyword"
        },
        "confidence": {
          "properties": {
            "parse_score": {
              "type": "float"
            },
            "layout_score": {
              "type": "float"
            },
            "table_score": {
              "type": "float"
            },
            "ocr_score": {
              "type": "float"
            },
            "mean_score": {
              "type": "float"
            },
            "low_score": {
              "type": "float"
            },
            "mean_grade": {
              "type": "keyword"
            },
            "low_grade": {
              "type": "keyword"
            }
          }
        },
        "ingested_at": {
          "type": "date"
        }
      }
    }
  },
  "pipeline": {
    "description": "Populate semantic_text fields for each normalized RAG chunk and neutralize shell-style placeholders before custom inference templating.",
    "processors": [
      {
        "set": {
          "field": "ingested_at",
          "value": "{{{_ingest.timestamp}}}"
        }
      },
      {
        "script": {
          "lang": "painless",
          "source": "if (ctx.content != null) { ctx.content_semantic = ctx.content.replace('${', '$ {'); } if (ctx.title != null) { ctx.title_semantic = ctx.title.replace('${', '$ {'); }"
        }
      }
    ]
  }
}

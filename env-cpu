# CPU local development environment for macOS and Linux hosts.
# Source this file before local API runs:
# set -a; source env-cpu; set +a

INGEST_SERVICE_NAME=ingest-orquestator-server
INGEST_STORAGE_DIR=.data
INGEST_MAX_UPLOAD_SIZE_MB=100
INGEST_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.md,.markdown,.txt,.html,.htm,.docx,.pptx,.xlsx,.csv,.json,.adoc,.asciidoc,.tex,.latex,.vtt,.jats,.nxml,.uspto,.xbrl
INGEST_CHUNKING_ENABLED=true
INGEST_CHUNKING_STRATEGY=hybrid
INGEST_CHUNK_MAX_TOKENS=768
INGEST_CHUNK_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
INGEST_CHUNK_MERGE_PEERS=true
INGEST_CHUNK_REPEAT_TABLE_HEADER=true
INGEST_CHUNK_OMIT_HEADER_ON_OVERFLOW=false
INGEST_CHUNK_OMIT_PREFIX_ON_OVERFLOW=false
INGEST_CHUNK_SIZE_CHARS=1200
INGEST_CHUNK_OVERLAP_CHARS=150
INGEST_EMBEDDING_OUTPUT_ENABLED=true
INGEST_QUEUE_BACKEND=local
INGEST_RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
INGEST_DRAMATIQ_PARSER_QUEUE_NAME=ingest_parser_jobs
INGEST_DRAMATIQ_DISPATCH_QUEUE_NAME=ingest_dispatch_jobs
INGEST_PARSER_WORKER_COUNT=2
INGEST_DISPATCH_WORKER_COUNT=2
INGEST_DISPATCH_QUEUE_MAX_SIZE=100
INGEST_DISPATCH_QUEUE_MAX_PAYLOAD_BYTES=
INGEST_DISPATCH_MAX_BULK_SIZE=5
INGEST_DISPATCH_IDLE_INTERVAL_SECONDS=0.5
INGEST_DISPATCH_SINK_MODE=local
INGEST_DISPATCH_MAX_RETRIES=3
INGEST_EMBEDDING_ELASTIC_URL=https://elastic.example:9200
INGEST_EMBEDDING_ELASTIC_USERNAME=elastic-user
INGEST_EMBEDDING_ELASTIC_PASSWORD=change-me-locally
INGEST_EMBEDDING_ELASTIC_INDEX=open-rag-embeddings-v2
INGEST_EMBEDDING_ELASTIC_MAPPING_VERSION=v2
INGEST_EMBEDDING_ELASTIC_PIPELINE=
INGEST_EMBEDDING_ELASTIC_VERIFY_CERTS=true
INGEST_EMBEDDING_ELASTIC_REQUEST_TIMEOUT_SECONDS=30
INGEST_EMBEDDING_ELASTIC_MAX_RETRIES=3
INGEST_CONFIDENCE_OUTPUT_ENABLED=true
INGEST_CONFIDENCE_MIN_DOCUMENT_SCORE=0.8
INGEST_CONFIDENCE_WARN_ONLY=true
INGEST_PROGRESS_LOG_INTERVAL_SECONDS=30
INGEST_PROGRESS_PAGE_INTERVAL=1
INGEST_PROGRESS_HISTORY_LIMIT=50
INGEST_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INGEST_RETENTION_DAYS=30

INGEST_DOCLING_ACCELERATOR_DEVICE=cpu
INGEST_DOCLING_NUM_THREADS=4
INGEST_DOCLING_CUDA_USE_FLASH_ATTENTION2=false
INGEST_DOCLING_ALLOW_EXTERNAL_PLUGINS=false
INGEST_DOCLING_PIPELINE=standard
INGEST_DOCLING_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
INGEST_DOCLING_VLM_PROMPT="Convert this page to markdown."
INGEST_DOCLING_VLM_RESPONSE_FORMAT=markdown
INGEST_DOCLING_VLM_SCALE=2.0
INGEST_DOCLING_REMOTE_LLM_URL=http://localhost:8000/v1/chat/completions
INGEST_DOCLING_REMOTE_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
INGEST_DOCLING_REMOTE_LLM_API_KEY=
INGEST_DOCLING_REMOTE_LLM_API_KEY_HEADER=Authorization
INGEST_DOCLING_REMOTE_LLM_API_KEY_SCHEME=Bearer
INGEST_DOCLING_REMOTE_LLM_TIMEOUT_SECONDS=90
INGEST_DOCLING_REMOTE_LLM_MAX_TOKENS=4096
INGEST_DOCLING_REMOTE_LLM_TEMPERATURE=0
INGEST_DOCLING_REMOTE_LLM_PROVIDER=openai_compatible
INGEST_DOCLING_REMOTE_LLM_HEALTH_CHECK_ENABLED=false
INGEST_DOCLING_REMOTE_LLM_HEALTH_CHECK_TIMEOUT_SECONDS=5
INGEST_DOCLING_XBRL_ENABLE_LOCAL_FETCH=false
INGEST_DOCLING_XBRL_ENABLE_REMOTE_FETCH=false
INGEST_DOCLING_XBRL_TAXONOMY_PATH=/path/to/xbrl-taxonomy

INGEST_DOCLING_PDF_DO_OCR=true
INGEST_DOCLING_PDF_OCR_ENGINE=auto
INGEST_DOCLING_PDF_OCR_LANGUAGES=en
INGEST_DOCLING_PDF_OCR_USE_GPU=false

ARG PYTORCH_CUDA_IMAGE=pytorch/pytorch:2.12.0-cuda13.2-cudnn9-runtime
FROM ${PYTORCH_CUDA_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml requirements.txt README.md ./
COPY src ./src

RUN pip install --no-cache-dir --no-build-isolation -r requirements.txt \
    && pip install --no-cache-dir --no-deps . \
    && python -c "import docling_surya; import flash_attn; import flashinfer"

EXPOSE 8000

CMD ["uvicorn", "ingest_orquestator_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
